{
  "expo": {
    "name": "SuppClarity",
    "slug": "suppclarity",
    "version": "0.7.0",
    "orientation": "default",
    "icon": "./assets/app-icon-v2.png",
    "scheme": "suppclarity",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "om.medresearchacademy.suppclarity",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "om.medresearchacademy.suppclarity",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-v2.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/app-icon-v2.png",
      "bundler": "metro",
      "output": "single",
      "name": "SuppClarity",
      "description": "A clear starting point for your supplement routine. General education for adults."
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a supplement label photo to read and confirm its quantities.",
          "cameraPermission": "Photograph Supplement Facts to read and confirm the label.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d00f38f9-b750-46a3-88e9-b6a186d8a293"
      }
    },
    "owner": "alalawi2"
  }
}
