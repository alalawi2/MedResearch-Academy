# Public app configuration; these are RevenueCat SDK keys, never secret API keys.
# Leave false until store sandbox tests and backend readiness succeed.
EXPO_PUBLIC_PLUS_ENABLED=false
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Development web design only; production builds reject this setting.
# EXPO_PUBLIC_PLUS_PREVIEW=member

# Optional HTTPS backend for native sandbox QA; production builds use the live service.
# EXPO_PUBLIC_SUPPCLARITY_API_ORIGIN=https://your-owned-test-deployment.example
