{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.22.1"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "24.22.1",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "node": "24.22.1",
      "android": {
        "gradleCommand": ":app:bundleRelease :app:assembleRelease",
        "applicationArchivePath": "android/app/build/outputs/bundle/release/*.aab"
      },
      "buildArtifactPaths": [
        "android/app/build/outputs/apk/release/*.apk"
      ]
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "24.22.1",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6837860843",
        "appleTeamId": "7HSL5J37Z8"
      }
    }
  }
}
